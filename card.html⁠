<!DOCTYPE html>
<html lang="ht">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>LiveCash - Visa Cash</title>
  <style>
    :root {
      --bg-dark: #0a0c10;
      --card-bg: #12161f;
      --accent-gold: #d4af37;
      --text-white: #ffffff;
      --text-gray: #8a94a6;
      --border-color: #1e2532;
    }

    * { box-sizing: border-box; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
    body { background-color: var(--bg-dark); color: var(--text-white); margin: 0; padding: 16px; padding-bottom: 90px; }

    .app-container { max-width: 420px; margin: 0 auto; }

    /* Header Nav */
    .top-bar { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px; }
    .back-btn { text-decoration: none; color: var(--text-white); font-size: 20px; }
    .page-title { font-size: 18px; font-weight: 700; margin: 0; }

    /* Visual Virtual Card */
    .visa-card {
      background: linear-gradient(135deg, #111827 0%, #000000 100%);
      border: 1px solid var(--accent-gold);
      border-radius: 20px; padding: 22px; color: white;
      position: relative; box-shadow: 0 10px 25px rgba(212, 175, 55, 0.15);
      margin-bottom: 24px;
    }
    .card-top { display: flex; justify-content: space-between; align-items: center; }
    .brand-name { font-weight: 800; font-size: 18px; color: var(--accent-gold); }
    .chip { width: 42px; height: 30px; background: linear-gradient(135deg, #e6c666, #997a15); border-radius: 6px; }
    
    .card-number { font-size: 20px; font-weight: 700; letter-spacing: 2px; margin: 28px 0 15px 0; word-spacing: 4px; }
    .card-bottom { display: flex; justify-content: space-between; align-items: flex-end; }
    .card-holder { font-size: 12px; color: var(--text-gray); text-transform: uppercase; }
    .holder-name { font-size: 14px; font-weight: 700; color: white; margin-top: 2px; }
    .card-expiry { font-size: 12px; color: var(--text-gray); text-align: right; }
    .exp-date { font-size: 14px; font-weight: 700; color: white; margin-top: 2px; }

    /* Mero Menu List Options */
    .menu-list { background: var(--card-bg); border: 1px solid var(--border-color); border-radius: 20px; overflow: hidden; }
    .menu-item {
      display: flex; align-items: center; padding: 16px;
      border-bottom: 1px solid var(--border-color); cursor: pointer; transition: background 0.2s;
    }
    .menu-item:last-child { border-bottom: none; }
    .menu-item:active { background: #1a202c; }
    .menu-icon {
      width: 42px; height: 42px; background: rgba(255, 255, 255, 0.05); border-radius: 12px;
      display: flex; align-items: center; justify-content: center; margin-right: 14px; font-size: 18px;
    }
    .menu-text h4 { margin: 0; font-size: 15px; font-weight: 600; color: var(--text-white); }
    .menu-text p { margin: 3px 0 0; font-size: 12px; color: var(--text-gray); }

    /* Modal PIN Sekirite */
    .pin-modal-overlay {
      position: fixed; top: 0; left: 0; width: 100%; height: 100%;
      background: rgba(0, 0, 0, 0.85); backdrop-filter: blur(5px);
      display: flex; align-items: center; justify-content: center; z-index: 1000;
    }
    .pin-modal-box {
      background: var(--card-bg); border: 1px solid var(--accent-gold); border-radius: 24px;
      padding: 25px; text-align: center; width: 90%; max-width: 340px; color: #ffffff;
    }
    .pin-inputs { display: flex; justify-content: center; gap: 10px; margin: 20px 0; }
    .pin-code {
      width: 48px; height: 52px; text-align: center; font-size: 22px;
      background: #0a0c10; border: 1px solid var(--border-color); color: var(--accent-gold);
      border-radius: 10px; font-weight: bold;
    }
    .pin-code:focus { border-color: var(--accent-gold); outline: none; }
    .btn-confirm-pin {
      width: 100%; background: var(--accent-gold); color: #000; font-weight: bold;
      padding: 14px; border: none; border-radius: 12px; cursor: pointer; font-size: 15px;
    }

    /* Bottom Navbar */
    .navbar {
      position: fixed; bottom: 0; left: 0; right: 0; background: #0e121a;
      border-top: 1px solid var(--border-color); display: flex; justify-content: space-around;
      padding: 12px 0; max-width: 420px; margin: 0 auto;
    }
    .nav-item { text-align: center; color: var(--text-gray); text-decoration: none; font-size: 11px; }
    .nav-item.active { color: var(--accent-gold); font-weight: bold; }
    .nav-icon { font-size: 20px; display: block; margin-bottom: 3px; }
  </style>
</head>
<body>

<div class="app-container">
  <!-- Top Bar -->
  <div class="top-bar">
    <a href="dashboard.html" class="back-btn">←</a>
    <h1 class="page-title">Visa Cash</h1>
    <div style="width:20px;"></div>
  </div>

  <!-- Visual Card -->
  <div class="visa-card">
    <div class="card-top">
      <span class="brand-name">LiveCash</span>
      <div class="chip"></div>
    </div>
    <div class="card-number" id="cardNumberDisplay">•••• •••• •••• 3592</div>
    <div class="card-bottom">
      <div>
        <div class="card-holder">Titilè</div>
        <div class="holder-name">BRUNVIL KERBY</div>
      </div>
      <div>
        <div class="card-expiry">Ekspire</div>
        <div class="exp-date" id="cardExpDisplay">••/••</div>
      </div>
    </div>
  </div>

  <!-- Mero List Options -->
  <div class="menu-list">
    <div class="menu-item" onclick="openPinModal('details')">
      <div class="menu-icon">💳</div>
      <div class="menu-text">
        <h4>Voir les détails</h4>
        <p>16 chif, CVC, ak dat ekspirasyon</p>
      </div>
    </div>

    <div class="menu-item">
      <div class="menu-icon">⚡</div>
      <div class="menu-text">
        <h4>Limites</h4>
        <p>Afficher les limites de votre carte</p>
      </div>
    </div>

    <div class="menu-item" onclick="openPinModal('pin')">
      <div class="menu-icon">🔑</div>
      <div class="menu-text">
        <h4>Afficher le code PIN</h4>
        <p>Wè kòd PIN kat la</p>
      </div>
    </div>

    <div class="menu-item">
      <div class="menu-icon">✏️</div>
      <div class="menu-text">
        <h4>Changer le code PIN</h4>
        <p>Modifye kòd PIN kat la</p>
      </div>
    </div>

    <div class="menu-item">
      <div class="menu-icon">📜</div>
      <div class="menu-text">
        <h4>Voir les transactions</h4>
        <p>Istwa tout peman kat la fè</p>
      </div>
    </div>

    <div class="menu-item">
      <div class="menu-icon">🔒</div>
      <div class="menu-text">
        <h4>Bloquer la carte</h4>
        <p>Gele kat la an tan reyèl</p>
      </div>
    </div>

    <div class="menu-item">
      <div class="menu-icon">📍</div>
      <div class="menu-text">
        <h4>Adresse de facturation</h4>
        <p>Voir l'adresse de facturation US</p>
      </div>
    </div>
  </div>
</div>

<!-- Modal Popup PIN Sekirite -->
<div id="pinModal" class="pin-modal-overlay" style="display: none;">
  <div class="pin-modal-box">
    <h3 style="margin:0 0 8px 0;">Sekirite LiveCash</h3>
    <p style="font-size:13px; color:var(--text-gray); margin:0;">Antre PIN 4 chif ou pou debloke enfòmasyon sa yo</p>
    
    <div class="pin-inputs">
      <input type="password" maxlength="1" class="pin-code" autofocus>
      <input type="password" maxlength="1" class="pin-code">
      <input type="password" maxlength="1" class="pin-code">
      <input type="password" maxlength="1" class="pin-code">
    </div>

    <button class="btn-confirm-pin" onclick="unlockCardDetails()">Debloke Kat la</button>
    <div style="margin-top:12px; font-size:12px; color:var(--text-gray); cursor:pointer;" onclick="closePinModal()">Anule</div>
  </div>
</div>

<!-- Bottom Navbar -->
<div class="navbar">
  <a href="dashboard.html" class="nav-item"><span class="nav-icon">🏠</span>Akèy</a>
  <a href="card.html" class="nav-item active"><span class="nav-icon">💳</span>Kat</a>
  <a href="boost.html" class="nav-item"><span class="nav-icon">🚀</span>Boost</a>
  <a href="#" class="nav-item"><span class="nav-icon">👤</span>Pwofil</a>
</div>

<script>
  // Automatic Focus Switch nan PIN Inputs
  const pinInputs = document.querySelectorAll('.pin-code');
  pinInputs.forEach((input, index) => {
    input.addEventListener('input', () => {
      if (input.value.length === 1 && index < pinInputs.length - 1) {
        pinInputs[index + 1].focus();
      }
    });
  });

  function openPinModal() {
    document.getElementById('pinModal').style.display = 'flex';
  }

  function closePinModal() {
    document.getElementById('pinModal').style.display = 'none';
  }

  function unlockCardDetails() {
    // Lè backend ap deplwaye, l ap tcheke vwe PIN sou Firebase
    document.getElementById('cardNumberDisplay').innerText = '4242 4242 4242 3592 (CVC: 884)';
    document.getElementById('cardExpDisplay').innerText = '12/28';
    closePinModal();
    alert("Enfòmasyon kat yo debloke!");
  }
</script>

</body>
</html>
