<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>LiveCash - Transfert</title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap');

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Poppins', sans-serif;
    }

    body {
      background: #071a12;
      color: #ffffff;
      padding: 16px;
      max-width: 480px;
      margin: 0 auto;
      min-height: 100vh;
      padding-bottom: 90px;
    }

    /* Top Bar Header */
    .top-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 20px;
    }

    .brand-section {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .back-icon {
      width: 42px;
      height: 42px;
      background: #0f3322;
      border: 1px solid #facc15;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 18px;
      cursor: pointer;
      color: #facc15;
      text-decoration: none;
      box-shadow: 0 4px 10px rgba(0,0,0,0.3);
    }

    .logo-text {
      font-size: 20px;
      font-weight: 800;
      color: #facc15;
      letter-spacing: -0.5px;
    }

    /* Solde Display Box */
    .balance-box {
      background: linear-gradient(135deg, #0f3322, #14442d);
      border-left: 4px solid #facc15;
      border-radius: 16px;
      padding: 16px;
      margin-bottom: 24px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      box-shadow: 0 4px 15px rgba(0,0,0,0.3);
    }

    .balance-info p {
      font-size: 11px;
      color: #a7f3d0;
      font-weight: 600;
      text-transform: uppercase;
    }

    .balance-amount {
      font-size: 22px;
      font-weight: 800;
      color: #ffffff;
    }

    /* Form Container */
    .transfer-card {
      background: #0f3322;
      border: 1px solid rgba(250, 204, 21, 0.25);
      border-radius: 18px;
      padding: 20px 16px;
      box-shadow: 0 4px 20px rgba(0,0,0,0.4);
    }

    .form-title {
      font-size: 16px;
      font-weight: 800;
      color: #facc15;
      margin-bottom: 16px;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .form-group {
      margin-bottom: 16px;
    }

    .form-group label {
      display: block;
      font-size: 12px;
      font-weight: 700;
      color: #a7f3d0;
      margin-bottom: 6px;
    }

    .form-group input {
      width: 100%;
      background: #071a12;
      border: 1px solid rgba(250, 204, 21, 0.3);
      border-radius: 12px;
      padding: 12px;
      color: #ffffff;
      font-weight: 600;
      font-size: 14px;
      outline: none;
      transition: 0.2s;
    }

    .form-group input:focus {
      border-color: #facc15;
      box-shadow: 0 0 8px rgba(250, 204, 21, 0.3);
    }

    .input-hint {
      font-size: 11px;
      color: #94a3b8;
      margin-top: 4px;
    }

    .btn-submit {
      width: 100%;
      background: linear-gradient(135deg, #facc15, #ca8a04);
      color: #071a12;
      border: none;
      padding: 14px;
      border-radius: 12px;
      font-weight: 800;
      font-size: 15px;
      cursor: pointer;
      margin-top: 8px;
      box-shadow: 0 4px 12px rgba(250, 204, 21, 0.25);
      transition: 0.2s;
    }

    .btn-submit:active {
      transform: scale(0.98);
    }

    /* Alert Box */
    .alert-msg {
      display: none;
      padding: 12px;
      border-radius: 10px;
      font-size: 12px;
      font-weight: 700;
      margin-bottom: 16px;
      text-align: center;
    }

    .alert-success {
      background: rgba(34, 197, 94, 0.2);
      border: 1px solid #22c55e;
      color: #4ade80;
    }

    .alert-danger {
      background: rgba(239, 68, 68, 0.2);
      border: 1px solid #ef4444;
      color: #f87171;
    }

    /* Bottom Nav */
    .bottom-nav {
      position: fixed;
      bottom: 0;
      left: 50%;
      transform: translateX(-50%);
      width: 100%;
      max-width: 480px;
      background: #092418;
      border-top: 1px solid rgba(250, 204, 21, 0.3);
      display: flex;
      justify-content: space-around;
      padding: 10px 0;
      z-index: 100;
    }

    .nav-item {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-decoration: none;
      color: #94a3b8;
      font-size: 10px;
      font-weight: 600;
    }

    .nav-item.active, .nav-item:hover {
      color: #facc15;
    }

    .nav-icon {
      font-size: 18px;
      margin-bottom: 2px;
    }
  </style>
</head>
<body>

  <!-- Top Header -->
  <div class="top-header">
    <div class="brand-section">
      <a href="index.html" class="back-icon">←</a>
      <div class="logo-text">Transfert LiveCash</div>
    </div>
  </div>

  <!-- Display Solde HTG -->
  <div class="balance-box">
    <div class="balance-info">
      <p>Votre Solde HTG</p>
      <div class="balance-amount" id="userBalanceHTG">0.00 HTG</div>
    </div>
    <div style="font-size: 24px;">💸</div>
  </div>

  <!-- Formulaire Transfert -->
  <div class="transfer-card">
    <div class="form-title">
      <span>💸 Envoyer des fonds</span>
    </div>

    <div id="alertMsg" class="alert-msg"></div>

    <form id="transferForm" onsubmit="handleTransfer(event)">
      <div class="form-group">
        <label for="recipientID">ID du Destinataire</label>
        <input type="text" id="recipientID" placeholder="Ex: LC-85940" required>
        <div class="input-hint">Antre ID kont LiveCash moun w ap voye lajan an ba li a.</div>
      </div>

      <div class="form-group">
        <label for="transferAmount">Montant (HTG)</label>
        <input type="number" id="transferAmount" min="10" placeholder="Ex: 500" required>
        <div class="input-hint">Montant minimum: 10 HTG</div>
      </div>

      <div class="form-group">
        <label for="transferNote">Note / Motif (Opsyonèl)</label>
        <input type="text" id="transferNote" placeholder="Ex: Ranbousman, Kado...">
      </div>

      <button type="submit" class="btn-submit" id="btnSubmit">Konfime Transfert a</button>
    </form>
  </div>

  <!-- Bottom Nav -->
  <div class="bottom-nav">
    <a href="index.html" class="nav-item">
      <span class="nav-icon">🏠</span>
      <span>Accueil</span>
    </a>
    <a href="carte.html" class="nav-item">
      <span class="nav-icon">💳</span>
      <span>Carte</span>
    </a>
    <a href="boostage.html" class="nav-item">
      <span class="nav-icon">🚀</span>
      <span>Boost</span>
    </a>
    <a href="historique.html" class="nav-item">
      <span class="nav-icon">📜</span>
      <span>Historique</span>
    </a>
  </div>

  <script>
    let currentUser = {};

    function loadUserData() {
      // Rekipere done itilizatè a nan LocalStorage
      currentUser = JSON.parse(localStorage.getItem('currentUser')) || {
        fullName: "Utilisateur LiveCash",
        email: "client@livecash.com",
        balanceHTG: 0,
        cardUSD: 0.00
      };

      document.getElementById('userBalanceHTG').innerText = `${currentUser.balanceHTG.toLocaleString()} HTG`;
    }

    function showAlert(message, type) {
      const alertBox = document.getElementById('alertMsg');
      alertBox.innerText = message;
      alertBox.className = `alert-msg alert-${type}`;
      alertBox.style.display = 'block';
    }

    function handleTransfer(e) {
      e.preventDefault();

      const recipientID = document.getElementById('recipientID').value.trim().toUpperCase();
      const amount = parseFloat(document.getElementById('transferAmount').value);
      const note = document.getElementById('transferNote').value.trim();
      const myID = localStorage.getItem('livecash_user_id');

      // Validation yo
      if (!recipientID.startsWith('LC-')) {
        showAlert("❌ Format ID a pa bon. Li dwe kòmanse ak 'LC-' (Eg: LC-12345).", "danger");
        return;
      }

      if (recipientID === myID) {
        showAlert("❌ Ou pa ka fè yon transfer bay pwòp ID pa w!", "danger");
        return;
      }

      if (isNaN(amount) || amount < 10) {
        showAlert("❌ Montant an dwe omwen 10 HTG.", "danger");
        return;
      }

      if (amount > currentUser.balanceHTG) {
        showAlert("❌ Solde HTG ou pa ase pou fè transfer sa a.", "danger");
        return;
      }

      // Sware transfer la
      currentUser.balanceHTG -= amount;
      localStorage.setItem('currentUser', JSON.stringify(currentUser));

      // Sove nan Istorik tranzaksyon yo
      let history = JSON.parse(localStorage.getItem('livecash_history')) || [];
      const newTransaction = {
        id: 'TR-' + Math.floor(100000 + Math.random() * 900000),
        type: 'Transfert Envoyé',
        recipient: recipientID,
        amount: `- ${amount.toLocaleString()} HTG`,
        note: note || 'Transfert interne',
        date: new Date().toLocaleString('fr-FR'),
        status: 'Succès'
      };
      history.unshift(newTransaction);
      localStorage.setItem('livecash_history', JSON.stringify(history));

      // Mizajou nan baj la
      document.getElementById('userBalanceHTG').innerText = `${currentUser.balanceHTG.toLocaleString()} HTG`;
      document.getElementById('transferForm').reset();

      showAlert(`✅ Transfert ${amount.toLocaleString()} HTG bay ${recipientID} reyalize ak siksè!`, "success");
    }

    loadUserData();
  </script>

</body>
</html>
