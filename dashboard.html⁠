<!DOCTYPE html>
<html lang="ht">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>LiveCash - Dashboard</title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');

    :root {
      --bg-main: #0a0d14;
      --card-bg: rgba(18, 24, 38, 0.75);
      --card-border: rgba(255, 255, 255, 0.08);
      --primary-gold: linear-gradient(135deg, #f1c40f 0%, #e67e22 100%);
      --accent-gold: #f39c12;
      --text-white: #ffffff;
      --text-muted: #8c98a9;
      --success: #2ecc71;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Plus Jakarta Sans', sans-serif; -webkit-tap-highlight-color: transparent; }
    body { background-color: var(--bg-main); color: var(--text-white); padding-bottom: 100px; display: flex; justify-content: center; }

    .app-viewport { width: 100%; max-width: 430px; min-height: 100vh; padding: 18px; position: relative; }

    /* Top Bar Header */
    .top-bar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 22px; margin-top: 6px; }
    .user-profile { display: flex; align-items: center; gap: 12px; }
    .avatar-wrap { position: relative; }
    .avatar { width: 44px; height: 44px; border-radius: 50%; background: var(--primary-gold); display: flex; align-items: center; justify-content: center; font-weight: 800; color: #000; font-size: 16px; box-shadow: 0 4px 15px rgba(243, 156, 18, 0.3); }
    .status-dot { width: 10px; height: 10px; background: var(--success); border-radius: 50%; position: absolute; bottom: 0; right: 0; border: 2px solid var(--bg-main); }
    
    .user-text h4 { font-size: 15px; font-weight: 700; line-height: 1.2; }
    .user-text p { font-size: 11px; color: var(--text-muted); font-weight: 500; }

    .icon-btn { width: 42px; height: 42px; background: var(--card-bg); border: 1px solid var(--card-border); border-radius: 14px; display: flex; align-items: center; justify-content: center; color: var(--text-white); font-size: 18px; cursor: pointer; backdrop-filter: blur(10px); }

    /* Main Balance Card */
    .wallet-card {
      background: linear-gradient(135deg, rgba(255,255,255,0.05) 0%, rgba(255,255,255,0.01) 100%);
      border: 1px solid var(--card-border); border-radius: 24px; padding: 22px;
      backdrop-filter: blur(15px); box-shadow: 0 20px 40px rgba(0,0,0,0.4); margin-bottom: 24px;
      position: relative; overflow: hidden;
    }
    .wallet-card::after { content: ''; position: absolute; top: -50%; right: -50%; width: 150px; height: 150px; background: rgba(243, 156, 18, 0.15); filter: blur(50px); border-radius: 50%; }

    .wallet-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; }
    .wallet-label { font-size: 11px; text-transform: uppercase; letter-spacing: 1.5px; color: var(--text-muted); font-weight: 700; }
    .badge-live { background: rgba(46, 204, 113, 0.15); color: var(--success); border: 1px solid rgba(46, 204, 113, 0.3); padding: 3px 10px; border-radius: 20px; font-size: 10px; font-weight: 700; }

    .balance-val { font-size: 36px; font-weight: 800; color: #fff; margin-bottom: 20px; display: flex; align-items: baseline; gap: 8px; }
    .currency { font-size: 14px; color: var(--accent-gold); font-weight: 700; }

    .action-row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
    .btn-main { padding: 14px; border-radius: 14px; border: none; font-weight: 700; font-size: 13px; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 8px; transition: 0.2s; }
    .btn-gold { background: var(--primary-gold); color: #000; box-shadow: 0 8px 20px rgba(243, 156, 18, 0.25); }
    .btn-dark { background: rgba(255,255,255,0.06); color: #fff; border: 1px solid var(--card-border); }

    /* Section Header */
    .sec-title { font-size: 13px; font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: 1px; margin-bottom: 14px; display: flex; justify-content: space-between; align-items: center; }

    /* Virtual Card Preview Widget */
    .card-widget {
      background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
      border: 1px solid rgba(243, 156, 18, 0.3); border-radius: 20px; padding: 20px; margin-bottom: 24px;
      position: relative; box-shadow: 0 15px 30px rgba(0,0,0,0.5); text-decoration: none; color: #fff; display: block;
    }
    .card-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px; }
    .chip { width: 36px; height: 26px; background: linear-gradient(135deg, #e2e8f0, #94a3b8); border-radius: 6px; }
    .card-brand { font-size: 18px; font-weight: 800; font-style: italic; color: #fff; }
    .card-num { font-size: 16px; letter-spacing: 3px; font-family: monospace; color: rgba(255,255,255,0.8); margin-bottom: 15px; }
    .card-bottom { display: flex; justify-content: space-between; font-size: 11px; color: var(--text-muted); }

    /* Service Cards Grid */
    .services-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-bottom: 24px; }
    .srv-box {
      background: var(--card-bg); border: 1px solid var(--card-border); border-radius: 20px; padding: 18px;
      text-decoration: none; color: #fff; backdrop-filter: blur(10px); transition: 0.2s; display: flex; flex-direction: column; gap: 12px;
    }
    .srv-box:active { transform: scale(0.97); }
    .srv-icon { width: 44px; height: 44px; border-radius: 14px; background: rgba(243, 156, 18, 0.12); display: flex; align-items: center; justify-content: center; font-size: 20px; border: 1px solid rgba(243, 156, 18, 0.2); color: var(--accent-gold); }
    .srv-title { font-size: 14px; font-weight: 700; }
    .srv-desc { font-size: 11px; color: var(--text-muted); }

    /* Side Navigation Drawer */
    .drawer-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.8); backdrop-filter: blur(8px); z-index: 1000; display: none; }
    .drawer { position: fixed; top: 0; left: -300px; width: 280px; height: 100%; background: #0c1017; border-right: 1px solid var(--card-border); z-index: 1001; padding: 24px; transition: 0.3s ease; display: flex; flex-direction: column; justify-content: space-between; }
    .drawer.open { left: 0; }
    .drawer-overlay.open { display: block; }

    .drawer-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px; padding-bottom: 15px; border-bottom: 1px solid var(--card-border); }
    .drawer-item { display: flex; align-items: center; gap: 14px; padding: 14px; color: var(--text-white); text-decoration: none; font-size: 14px; font-weight: 600; border-radius: 12px; margin-bottom: 6px; cursor: pointer; }
    .drawer-item:hover, .drawer-item.active { background: rgba(243, 156, 18, 0.1); color: var(--accent-gold); }

    /* Floating Bottom Nav */
    .bot-nav { position: fixed; bottom: 20px; left: 50%; transform: translateX(-50%); width: 90%; max-width: 380px; background: rgba(15, 23, 42, 0.85); backdrop-filter: blur(20px); border: 1px solid var(--card-border); border-radius: 25px; padding: 10px 20px; display: flex; justify-content: space-between; align-items: center; box-shadow: 0 20px 40px rgba(0,0,0,0.6); z-index: 900; }
    .nav-link { text-decoration: none; color: var(--text-muted); font-size: 10px; font-weight: 600; display: flex; flex-direction: column; align-items: center; gap: 4px; cursor: pointer; }
    .nav-link.active { color: var(--accent-gold); }
    .nav-link span { font-size: 18px; }

    /* Modal Popup */
    .modal-bg { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.85); backdrop-filter: blur(10px); z-index: 2000; display: none; align-items: center; justify-content: center; padding: 20px; }
    .modal-content { background: #121826; border: 1px solid var(--card-border); border-radius: 24px; padding: 24px; width: 100%; max-width: 350px; text-align: center; }
    .modal-input { width: 100%; padding: 14px; background: #0a0d14; border: 1px solid var(--card-border); border-radius: 12px; color: #fff; margin: 18px 0; outline: none; font-size: 16px; text-align: center; }
  </style>
</head>
<body>

<!-- Side Menu Drawer Overlay -->
<div class="drawer-overlay" id="overlay" onclick="toggleMenu()"></div>

<!-- Drawer Menu -->
<aside class="drawer" id="drawer">
  <div>
    <div class="drawer-head">
      <h3 style="color: var(--accent-gold); font-weight: 800;">LiveCash</h3>
      <div style="cursor:pointer;" onclick="toggleMenu()">✕</div>
    </div>
    <nav>
      <a href="dashboard.html" class="drawer-item active"><span>🏠</span> Akèy</a>
      <a href="card.html" class="drawer-item"><span>💳</span> Kat Virtiyèl Visa</a>
      <a href="boost.html" class="drawer-item"><span>🚀</span> Boostaj Rezo Sosyo</a>
      <div class="drawer-item" onclick="toggleMenu(); openModal();"><span>⚡</span> Rechaje Kat</div>
      <div class="drawer-item"><span>📜</span> Istorik Tranzaksyon</div>
      <div class="drawer-item"><span>⚙️</span> Paramèt Pwofil</div>
    </nav>
  </div>
  <a href="index.html" class="drawer-item" style="color: #e74c3c;"><span>🚪</span> Dekonekte</a>
</aside>

<div class="app-viewport">
  <!-- Top Bar -->
  <header class="top-bar">
    <div class="user-profile">
      <div class="avatar-wrap">
        <div class="avatar">LC</div>
        <div class="status-dot"></div>
      </div>
      <div class="user-text">
        <h4>Benvini, LiveCash</h4>
        <p>Kont Verifye ✓</p>
      </div>
    </div>
    <div class="icon-btn" onclick="toggleMenu()">☰</div>
  </header>

  <!-- Balance Section -->
  <section class="wallet-card">
    <div class="wallet-header">
      <span class="wallet-label">Solde Pòtfèy</span>
      <span class="badge-live">AKTIF</span>
    </div>
    <div class="balance-val">$0.00 <span class="currency">USD</span></div>
    <div class="action-row">
      <button class="btn-main btn-gold" onclick="openModal()"><span>+</span> Recharger</button>
      <button class="btn-main btn-dark"><span>↓</span> Retire</button>
    </div>
  </section>

  <!-- Virtual Card Widget Preview -->
  <div class="sec-title">
    <span>KONT KAT VIRTIYÈL OU</span>
    <a href="card.html" style="color: var(--accent-gold); text-decoration: none; font-size: 11px;">Gere →</a>
  </div>
  
  <a href="card.html" class="card-widget">
    <div class="card-top">
      <div class="chip"></div>
      <div class="card-brand">VISA</div>
    </div>
    <div class="card-num">•••• •••• •••• 4092</div>
    <div class="card-bottom">
      <span>LiveCash Card Holder</span>
      <span>EXP: 12/28</span>
    </div>
  </a>

  <!-- Services Grid -->
  <div class="sec-title">SÈVIS RAPID YO</div>
  <div class="services-grid">
    <a href="card.html" class="srv-box">
      <div class="srv-icon">💳</div>
      <div>
        <div class="srv-title">Visa Cash</div>
        <div class="srv-desc">Achte ak Peye sou entènèt fasilman.</div>
      </div>
    </a>
    <a href="boost.html" class="srv-box">
      <div class="srv-icon">🚀</div>
      <div>
        <div class="srv-title">Boostaj Sosyo</div>
        <div class="srv-desc">Ogmante abòne ak views TikTok/IG.</div>
      </div>
    </a>
  </div>

</div>

<!-- Recharge Modal -->
<div class="modal-bg" id="rechargeModal">
  <div class="modal-content">
    <h3 style="color: var(--accent-gold); margin-bottom: 6px;">Rechaje Kat Visa</h3>
    <p style="font-size: 12px; color: var(--text-muted);">Antre montan USD ou vle mete sou kat la:</p>
    <input type="number" class="modal-input" placeholder="$0.00">
    <button class="btn-main btn-gold" style="width: 100%;" onclick="closeModal(); alert('Mèsi! Demann rechaj ou anrejistre.');">Konfime Rechaj</button>
    <p style="margin-top: 14px; font-size: 12px; color: var(--text-muted); cursor: pointer;" onclick="closeModal()">Anule</p>
  </div>
</div>

<!-- Bottom Nav -->
<nav class="bot-nav">
  <a href="dashboard.html" class="nav-link active"><span>🏠</span>Akèy</a>
  <a href="card.html" class="nav-link"><span>💳</span>Kat</a>
  <a href="boost.html" class="nav-link"><span>🚀</span>Boost</a>
  <div class="nav-link" onclick="toggleMenu()"><span>👤</span>Pwofil</div>
</nav>

<script>
  function toggleMenu() {
    document.getElementById('drawer').classList.toggle('open');
    document.getElementById('overlay').classList.toggle('open');
  }
  function openModal() {
    document.getElementById('rechargeModal').style.display = 'flex';
  }
  function closeModal() {
    document.getElementById('rechargeModal').style.display = 'none';
  }
</script>

</body>
</html>
